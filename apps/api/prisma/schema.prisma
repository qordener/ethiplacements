// Learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AssetType {
  STOCK
  ETF
  BOND
  CRYPTO
  OTHER
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
}

enum EsgLabelType {
  ISR
  GREENFIN
  FINANSOL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Portfolio {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  holdings    Holding[]
  deposits    Deposit[]
}

model Asset {
  id               String          @id @default(cuid())
  name             String
  ticker           String          @unique
  isin             String?
  type             AssetType
  sector           String?
  manualPrice      Float?
  manualPriceDate  DateTime?
  holdings         Holding[]
  esgScores        EsgScore[]
  priceSnapshots   PriceSnapshot[]
  labels           AssetLabel[]
}

model PriceSnapshot {
  id        String   @id @default(cuid())
  assetId   String
  price     Float
  currency  String   @default("EUR")
  source    String   @default("yahoo")
  fetchedAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, fetchedAt])
}

model Holding {
  id           String        @id @default(cuid())
  portfolioId  String
  assetId      String
  quantity     Float
  averagePrice Float
  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset        Asset         @relation(fields: [assetId], references: [id])
  transactions Transaction[]

  @@unique([portfolioId, assetId])
}

model Transaction {
  id        String          @id @default(cuid())
  holdingId String
  type      TransactionType
  quantity  Float
  price     Float
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())
  holding   Holding         @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

// Versement de liquidités dans l'enveloppe du portefeuille (ex : PEA).
// Distinct des Transaction (achat/vente d'un actif) : un arbitrage interne
// (vente puis rachat) ne doit jamais compter comme un nouveau versement,
// donc le plafond réglementaire se calcule sur ce modèle, pas sur les BUY.
model Deposit {
  id          String    @id @default(cuid())
  portfolioId String
  amount      Float
  date        DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

// Label officiel (ISR/Greenfin/Finansol) obtenu par un fonds, tel que
// consolidé par la Banque de France dans son référentiel trimestriel des
// OPC labellisés. Distinct de EsgScore (score numérique, saisi manuellement
// ou par fournisseur) : ceci est un fait vérifiable avec source et date,
// pas une estimation.
model AssetLabel {
  id        String       @id @default(cuid())
  assetId   String
  label     EsgLabelType
  source    String       @default("Banque de France")
  asOfDate  DateTime
  fetchedAt DateTime     @default(now())
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, label])
}

model EsgScore {
  id       String   @id @default(cuid())
  assetId  String
  score    Float    // 0 à 100
  provider String   // ex: "manual", "MSCI", "Sustainalytics"
  date     DateTime @default(now())
  details  String?  // JSON sérialisé avec le détail par critère (E, S, G)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}
